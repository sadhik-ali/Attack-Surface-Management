# Docker Compose environment. Copy to .env and replace every value marked CHANGE.
# The API refuses to start in production with the development signing key.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ASM_SECRET_KEY=CHANGE-me-generate-a-48-byte-token

# Required by the postgres service.
POSTGRES_DB=asm
POSTGRES_USER=asm
POSTGRES_PASSWORD=CHANGE-me-use-a-long-random-password

# Host port for the nginx-fronted web app. Put a TLS-terminating reverse proxy
# in front of this port; compose itself serves plain HTTP.
ASM_WEB_PORT=8080
ASM_CORS_ORIGINS=http://localhost:8080

# Discovery is enabled, but every scan still requires an approved, unexpired
# authorization record. Set ASM_DISCOVERY_OFFLINE=true to block all outbound
# probing globally (active probe scan types are then rejected).
ASM_DISCOVERY_ENABLED=true
ASM_DISCOVERY_OFFLINE=false

# The compose topology never seeds automatically. For local evaluation only:
#   docker compose --profile demo run --rm seed
ASM_DEMO_MODE=false
