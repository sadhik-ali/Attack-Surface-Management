# Copy to .env and adjust. Every setting uses the ASM_ prefix.
ASM_APP_ENV=development

# Generate a value with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ASM_SECRET_KEY=replace-me-with-a-generated-token

# Dev/demo: SQLite. Production: postgresql+asyncpg://user:password@host:5432/asm
ASM_DATABASE_URL=sqlite+aiosqlite:///./asm.db

ASM_CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
ASM_API_PORT=8010

# in-process (no broker) or celery (uses ASM_REDIS_URL)
ASM_JOB_BACKEND=in-process
ASM_REDIS_URL=redis://localhost:6379/0

ASM_DISCOVERY_ENABLED=true
ASM_DEMO_MODE=true
